<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>one.dastec</groupId>
        <artifactId>javaw</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>javaw-bytecode</artifactId>

    <properties>
        <!-- Settings for the prescribed validation run; see docs/bytecode-test-performance.md. Override with -D. -->
        <javaw.test.forks>0.6C</javaw.test.forks>
        <javaw.test.argLine></javaw.test.argLine>
        <!-- JDK 17 used to derive the Unicode 13 tables; empty means discover it (JAVA_HOME_17*, macOS java_home). -->
        <javaw.jdk17.home></javaw.jdk17.home>
        <javaw.generated.resources>${project.build.directory}/generated-resources/jdk17</javaw.generated.resources>
        <javaw.generated.testResources>${project.build.directory}/generated-test-resources/jdk17</javaw.generated.testResources>
    </properties>

    <dependencies>
        <dependency>
            <groupId>one.dastec</groupId>
            <artifactId>javaw-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Generated Unicode tables are resources like the hand-written runtime sources, but live only in target/. -->
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>${javaw.generated.resources}</directory></resource>
        </resources>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource><directory>${javaw.generated.testResources}</directory></testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-jdk17-data</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/tools/generate-jdk17-data.py</argument>
                                <argument>--java-home=${javaw.jdk17.home}</argument>
                                <argument>--main-resources=${javaw.generated.resources}</argument>
                                <argument>--test-resources=${javaw.generated.testResources}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Each fork runs whole test classes sequentially; tests also spawn wat2wasm and a persistent node host. -->
                    <forkCount>${javaw.test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>${javaw.test.argLine}</argLine>
                    <systemPropertyVariables>
                        <!-- Per-test wall and compile times for test-timings.py (BytecodeTestTimings). -->
                        <javaw.compileTimes.dir>${project.build.directory}/test-timings</javaw.compileTimes.dir>
                        <!-- wat2wasm binaries keyed by WAT, flags and wabt version (WasmTestSupport). -->
                        <javaw.wasmCache.dir>${project.build.directory}/wasm-cache</javaw.wasmCache.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
