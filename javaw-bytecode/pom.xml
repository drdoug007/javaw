<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>one.dastec</groupId>
        <artifactId>javaw</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>javaw-bytecode</artifactId>

    <properties>
        <!-- Settings for the prescribed validation run; see docs/bytecode-test-performance.md. Override with -D. -->
        <javaw.test.forks>0.6C</javaw.test.forks>
        <javaw.test.argLine></javaw.test.argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>one.dastec</groupId>
            <artifactId>javaw-core</artifactId>
        </dependency>
        <dependency>
            <!-- Java 17 / Unicode 13 tables of the bundled runtime (exception-runtime/ resources) and the tests' oracle. -->
            <groupId>one.dastec</groupId>
            <artifactId>javaw-unicode-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Each fork runs whole test classes sequentially; tests also spawn wat2wasm and a persistent node host. -->
                    <forkCount>${javaw.test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>${javaw.test.argLine}</argLine>
                    <systemPropertyVariables>
                        <!-- Per-test wall and compile times for test-timings.py (BytecodeTestTimings). -->
                        <javaw.compileTimes.dir>${project.build.directory}/test-timings</javaw.compileTimes.dir>
                        <!-- wat2wasm binaries keyed by WAT, flags and wabt version (WasmTestSupport). -->
                        <javaw.wasmCache.dir>${project.build.directory}/wasm-cache</javaw.wasmCache.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
