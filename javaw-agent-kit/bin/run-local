#!/usr/bin/env python3
"""Runs kit tasks unattended with a local model served by oMLX, one fresh Claude Code session per task.

    OMLX_API_KEY=... javaw-agent-kit/bin/run-local [--model NAME] [--tasks N] [--task T01] [--timeout MINUTES]
    OMLX_API_KEY=... javaw-agent-kit/bin/run-local --retry [T05 T06 | all] [--fresh] --model OTHER-MODEL

--retry re-queues blocked tasks (`kit retry`) and runs each one again, by default continuing from its saved
attempt; --fresh starts from the task's starting point instead. Use it to give a different model a turn.

Each session gets a per-task permission allowlist (dontAsk mode: anything not listed is denied). The session may
edit only that task's allowed files, read anything, and run only `bin/kit` plus read-only shell commands. If a
session ends without `kit finish`, the runner blocks the task (its attempt is saved as a patch) and moves on.
Logs: javaw-agent-kit/target/kit/<ID>/session.log.
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent
ROOT = KIT.parent
sys.path.insert(0, str(KIT / "bin"))
KIT_TOOL = KIT / "bin" / "kit"

# Read-only commands only (no find: -delete/-exec; no cat/head/tail: the Read tool covers them).
READ_ONLY_BASH = ["git status", "git diff", "git log", "git show", "ls", "wc", "grep", "rg", "sed -n", "unzip -p",
                  "unzip -l", "javap"]


def kit(*args, capture=True):
    result = subprocess.run([sys.executable, str(KIT_TOOL), *args], cwd=ROOT, capture_output=capture, text=True)
    return result.returncode, (result.stdout if capture else "")


def task_meta(task_id):
    import importlib.machinery, importlib.util
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("kit_tool", str(KIT_TOOL))
    spec = importlib.util.spec_from_loader("kit_tool", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.task_meta(task_id), module.task_file(task_id), module


def settings(meta):
    editable = ["javaw-bytecode/src/main/java/one/dastec/javaw/bytecode/BytecodeExceptionRuntime.java",
                "javaw-agent-kit/reports/**"] + meta["allow"]
    allow = ["Read", "Glob", "Grep", "TodoWrite"]
    # "//" + absolute path: a single leading "/" would be relative to this settings file, which lives in target/.
    allow += ["Edit(/%s)" % (ROOT / path) for path in editable]
    allow += ["Bash(javaw-agent-kit/bin/kit:*)", "Bash(./javaw-agent-kit/bin/kit:*)"]
    allow += ["Bash(%s:*)" % command for command in READ_ONLY_BASH]
    protected = ["javaw-agent-kit/src/**", "javaw-agent-kit/bin/**", "javaw-agent-kit/tasks/**", "javaw-agent-kit/*.md",
                 "javaw-bytecode/src/main/java/one/dastec/javaw/bytecode/cache/**", "runtime-target/**"]
    deny = ["Edit(/%s)" % (ROOT / path) for path in protected if not any(path == a for a in meta["allow"])]
    deny += ["Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git reset:*)",
            "Bash(git stash:*)", "Bash(git push:*)", "Bash(rm:*)", "WebFetch", "WebSearch"]
    return {"permissions": {"allow": allow, "deny": deny, "defaultMode": "dontAsk"},
            "useAutoModeDuringPlan": False}


def prompt(task_id, spec):
    return (f"You are the local agent for the javaw project. Your task is {task_id}; it is already started.\n"
            f"1. Read javaw-agent-kit/AGENT.md and javaw-agent-kit/RULES.md.\n"
            f"2. Read the task file {spec.relative_to(ROOT)} completely, then the test classes it names.\n"
            f"3. Follow the loop in AGENT.md from step 5: implement (register new classes with "
            f"`javaw-agent-kit/bin/kit register <path>`), run `javaw-agent-kit/bin/kit check {task_id}` "
            f"until it prints PASS, write javaw-agent-kit/reports/{task_id}.md, then run "
            f"`javaw-agent-kit/bin/kit finish {task_id}`.\n"
            f"If you are stuck after 6 fix attempts on the same failure, run "
            f"`javaw-agent-kit/bin/kit block {task_id} \"reason\"`. Do only this task.\n"
            f"After `kit finish` or `kit block` prints its result, STOP IMMEDIATELY: do not write, edit or run anything "
            f"else, and do not run `kit block` twice.")


def environment(args):
    env = dict(os.environ)
    base = "http://%s:%s" % (args.host, args.port)
    env.update({
        "ANTHROPIC_BASE_URL": base,
        "ANTHROPIC_AUTH_TOKEN": args.api_key or "omlx",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_MODEL": args.model,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": args.model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": args.model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": args.model,
        "CLAUDE_CODE_SUBAGENT_MODEL": args.model,
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "API_TIMEOUT_MS": "3000000",
        "KIT_MODEL": args.model,
    })
    if args.context:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(args.context)
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(args.context)
    return env


CLAUDE_CODE_MIN_CONTEXT = 100_000   # Claude Code treats smaller auto-compact windows as 100K
DEFAULT_CONTEXT = 131_072           # enough room for Claude Code's prompt plus a task; KV cache fits easily in 48 GB


def served_context(args):
    """The model's context length as served by oMLX (max_model_len / max_context_window), or None if unknown."""
    import urllib.request
    request = urllib.request.Request("http://%s:%s/v1/models" % (args.host, args.port),
                                     headers={"Authorization": "Bearer " + (args.api_key or "omlx")})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            models = json.load(response).get("data", [])
    except Exception as error:
        print("warning: could not ask oMLX for the model's context length (%s)" % error)
        return None
    for model in models:
        if model.get("id") == args.model:
            for key in ("max_context_window", "max_model_len", "context_length"):
                if isinstance(model.get(key), int) and model[key] > 0:
                    return model[key]
            return None
    sys.exit("oMLX does not serve a model named %r. Available: %s" % (args.model, ", ".join(m.get("id", "?") for m in models)))


def resolve_context(args):
    served = served_context(args)
    context = args.context or (min(DEFAULT_CONTEXT, served) if served else DEFAULT_CONTEXT)
    if served and context > served:
        sys.exit("--context %d is larger than the %d tokens oMLX serves for %s." % (context, served, args.model))
    if context < CLAUDE_CODE_MIN_CONTEXT:
        sys.exit("A %d-token context is too small: Claude Code's own prompt takes ~25K tokens and it will not "
                 "compact below %d, so the session thrashes. Configure %s in oMLX with at least 131072 tokens "
                 "(the model supports 262144) and pass --context 131072." % (context, CLAUDE_CODE_MIN_CONTEXT, args.model))
    print("context window: %d tokens (oMLX serves %s)" % (context, served or "unknown"))
    return context


def blocked_tasks():
    rows = []
    for line in (KIT / "tasks" / "QUEUE.md").read_text().splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and cells[3] == "blocked" and cells[0][:1] == "T":
            rows.append(cells[0])
    return rows


def status_of(task_id):
    for line in (KIT / "tasks" / "QUEUE.md").read_text().splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if cells and cells[0] == task_id and len(cells) >= 4:
            return cells[3]
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--model", default=os.environ.get("KIT_MODEL", "Qwen3-Coder-30B-A3B-Instruct-MLX-4bit"))
    parser.add_argument("--api-key", default=os.environ.get("OMLX_API_KEY"))
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", default="8000")
    parser.add_argument("--context", type=int, default=int(os.environ.get("KIT_CONTEXT", "0")) or None,
                        help="context window in tokens for auto-compaction (default: min(131072, what oMLX serves); "
                             "must be at least 100000)")
    parser.add_argument("--resume", action="store_true",
                        help="continue a retried task from its saved attempt (see `kit retry`)")
    parser.add_argument("--tasks", type=int, default=1, help="how many tasks to attempt (default 1)")
    parser.add_argument("--task", help="attempt this task ID instead of `kit next`")
    parser.add_argument("--retry", nargs="*", metavar="TASK",
                        help="re-queue these blocked tasks (default or `all`: every blocked task) and run each again")
    parser.add_argument("--fresh", action="store_true",
                        help="with --retry: ignore the saved attempt and start each task from scratch")
    parser.add_argument("--timeout", type=int, default=120, help="minutes per session (default 120)")
    parser.add_argument("--dry-run", action="store_true", help="print the session command and settings, run nothing")
    args = parser.parse_args()
    if args.fresh and args.retry is None:
        parser.error("--fresh only applies to --retry")
    if args.retry is not None and (args.task or args.resume):
        parser.error("--retry replaces --task/--resume: name the tasks after --retry")
    retry = None
    if args.retry is not None:
        blocked = blocked_tasks()
        retry = blocked if args.retry in ([], ["all"]) else [t.upper() for t in args.retry]
        not_blocked = [t for t in retry if t not in blocked]
        if not_blocked:
            sys.exit("not blocked: %s (blocked: %s)" % (", ".join(not_blocked), ", ".join(blocked) or "none"))
        if not retry:
            sys.exit("No blocked task to retry.")
    args.context = resolve_context(args)
    if retry:
        print("model: %s; retrying %s (%s)" % (args.model, ", ".join(retry),
                                             "fresh start" if args.fresh else "continuing saved attempts"))

    for attempt in range(len(retry) if retry else args.tasks):
        if retry:
            task_id = retry[attempt]
        elif args.task and attempt == 0:
            task_id = args.task
        else:
            code, out = kit("next", "--id")
            if code != 0:
                print("No ready task left.")
                return 0
            task_id = out.strip()
        meta, spec, _ = task_meta(task_id)
        log_dir = KIT / "target" / "kit" / task_id
        log_dir.mkdir(parents=True, exist_ok=True)
        settings_file = log_dir / "session-settings.json"
        settings_file.write_text(json.dumps(settings(meta), indent=2))
        command = ["claude", "-p", prompt(task_id, spec), "--settings", str(settings_file),
                   "--permission-mode", "dontAsk", "--disallowedTools", "Agent", "LSP", "WebFetch", "WebSearch", "Skill",
                   "--model", args.model, "--output-format", "text"]
        if args.dry_run:
            print(json.dumps(command, indent=1))
            print(settings_file.read_text())
            return 0
        if retry:
            code, out = kit("retry", task_id)
            print(out)
            if code != 0:
                print("Could not re-queue %s; stopping." % task_id)
                return 1
        resume = (retry and not args.fresh) or (args.resume and attempt == 0)
        code, out = kit("start", task_id, *(["--resume"] if resume else []))
        print(out)
        if code != 0:
            print("Could not start %s; stopping." % task_id)
            return 1
        log = log_dir / "session.log"
        print("== %s: session running (log: %s)" % (task_id, log.relative_to(ROOT)))
        with open(log, "w") as out_file:
            try:
                subprocess.run(command, cwd=ROOT, env=environment(args), stdout=out_file, stderr=subprocess.STDOUT,
                               timeout=args.timeout * 60)
            except subprocess.TimeoutExpired:
                out_file.write("\n[run-local] session timed out after %d minutes\n" % args.timeout)
        status = status_of(task_id)
        print("== %s: %s" % (task_id, status))
        if status not in ("done", "blocked"):
            kit("block", task_id, "local session ended without kit finish; see target/kit/%s/session.log" % task_id,
                capture=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
