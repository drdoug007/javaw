#!/usr/bin/env python3
"""Task runner and guard rails for the javaw local-agent kit.

Run from anywhere inside the repository:

    javaw-agent-kit/bin/kit doctor          check JDK 21, wat2wasm, node, Maven, branch
    javaw-agent-kit/bin/kit next            show the next task whose dependencies are done
    javaw-agent-kit/bin/kit start T01       begin a task (records the starting commit)
    javaw-agent-kit/bin/kit check T01       run the task's tests; prints a short failure summary
    javaw-agent-kit/bin/kit regress         run a small regression subset (about 15 s)
    javaw-agent-kit/bin/kit guard T01       verify the changes respect the task's guard rails
    javaw-agent-kit/bin/kit finish T01      guard + tests + full suite + revision bump + audit + commit
    javaw-agent-kit/bin/kit block T01 "why" give up: save the attempt as a patch, restore files, mark blocked
    javaw-agent-kit/bin/kit status          show the queue
    javaw-agent-kit/bin/kit review [COMMIT...] [--trusted-ref main]
                                            reviewer: check agent commits against task specs on main

Exit status is 0 on success and 1 on any failure, so a failed check is never mistaken for success.
"""
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

def _locate_kit():
    """The kit next to this script, or (for a copy such as /tmp/kit-main) the kit in the current git checkout."""
    here = Path(__file__).resolve().parent.parent
    if (here / "tasks" / "QUEUE.md").exists():
        return here
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    if top and (Path(top) / "javaw-agent-kit" / "tasks" / "QUEUE.md").exists():
        return Path(top) / "javaw-agent-kit"
    print("KIT FAILED: run this from inside the javaw repository (cannot find javaw-agent-kit/tasks/QUEUE.md)")
    sys.exit(1)


KIT = _locate_kit()
ROOT = KIT.parent
TASKS = KIT / "tasks"
QUEUE = TASKS / "QUEUE.md"
REPORTS = KIT / "reports"
STATE = KIT / "target" / "kit"
WORK_BRANCH = "agent-kit/work"
JDK21 = Path.home() / ".sdkman" / "candidates" / "java" / "21.0.2-graalce"
RUNTIME = "javaw-bytecode/src/main/resources/exception-runtime/"
REGISTRY = "javaw-bytecode/src/main/java/one/dastec/javaw/bytecode/BytecodeExceptionRuntime.java"
CACHE_METADATA = "javaw-bytecode/src/main/java/one/dastec/javaw/bytecode/cache/CacheMetadata.java"
BASELINE = "runtime-target/audit-baseline.json"
REGRESSION = ["KitHarnessSelfTest", "BytecodeExceptionRuntimeTest", "BytecodeArrayListTest", "BytecodeLinkedListTest",
              "BytecodeMapTest", "BytecodeCollectionFactoriesTest", "BytecodeStringsTest", "BytecodeSortedCollectionsTest"]
# Files every task may touch. The revision files may change only on their revision line (bin/kit finish edits them).
ALWAYS_ALLOWED = [REGISTRY, CACHE_METADATA, BASELINE, "javaw-agent-kit/tasks/QUEUE.md", "javaw-agent-kit/reports/*"]
# Never treated as task changes (IDE settings and user files are preserved, never committed).
IGNORED = [".idea/*", "*.iml", ".DS_Store"]
FORBIDDEN_IN_RUNTIME = [
    (r"\bsynchronized\b", "synchronized is rejected by admission; write single-threaded code"),
    (r"\bvolatile\b", "volatile fields are rejected by admission"),
    (r"\bnative\b", "native methods cannot be implemented in runtime sources"),
    (r"^\s*assert\b", "assert statements are not supported"),
    (r"System\.(out|err|in|currentTimeMillis|nanoTime|exit|getenv)\b", "this System member is not available in Wasm"),
    (r"\bThread\b", "threads are not available"),
    (r"Math\.random|new\s+Random\b", "no entropy source is available"),
    (r"@Disabled|@Tag\(", "test annotations do not belong in runtime sources"),
]


def fail(message):
    print("KIT FAILED: " + message)
    sys.exit(1)


def git(*args, check=True):
    result = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)
    if check and result.returncode != 0:
        fail("git " + " ".join(args) + "\n" + result.stderr.strip())
    return result.stdout


def java_env():
    env = dict(os.environ)
    home = Path(env.get("KIT_JAVA_HOME", str(JDK21)))
    env["JAVA_HOME"] = str(home)
    env["PATH"] = str(home / "bin") + os.pathsep + env.get("PATH", "")
    return env


# ---------------------------------------------------------------- tasks and queue

def task_file(task_id):
    matches = sorted(TASKS.glob(task_id + "-*.md"))
    if len(matches) != 1:
        fail("no single task file tasks/%s-*.md (found %d). Use an ID from `kit status`." % (task_id, len(matches)))
    return matches[0]


def task_meta(task_id):
    return parse_meta(task_file(task_id).read_text())


def parse_meta(text):
    block = re.search(r"```kit\n(.*?)```", text, re.S)
    if not block:
        fail("task file has no ```kit metadata block")
    meta = {"allow": [], "depends": []}
    for line in block.group(1).splitlines():
        if ":" not in line:
            continue
        key, value = (part.strip() for part in line.split(":", 1))
        if key == "allow":
            meta["allow"].append(value)
        elif key == "depends":
            meta["depends"] = [d.strip() for d in value.split(",") if d.strip() and d.strip() != "-"]
        else:
            meta[key] = value
    for key in ("id", "slug", "title", "tests"):
        if key not in meta:
            fail("task metadata is missing '%s'" % key)
    meta["tests"] = [t.strip() for t in meta["tests"].split(",") if t.strip()]
    return meta


def queue_rows():
    rows = []
    for line in QUEUE.read_text().splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and re.fullmatch(r"T\d+", cells[0]):
            rows.append({"id": cells[0], "title": cells[1], "depends": cells[2], "status": cells[3]})
    return rows


def set_status(task_id, status):
    lines = QUEUE.read_text().splitlines(keepends=True)
    for index, line in enumerate(lines):
        cells = line.split("|")
        if len(cells) >= 6 and cells[1].strip() == task_id:
            cells[4] = " %s " % status
            lines[index] = "|".join(cells)
    QUEUE.write_text("".join(lines))


def deps_done(row, rows):
    status = {r["id"]: r["status"] for r in rows}
    deps = [d.strip() for d in row["depends"].split(",") if d.strip() and d.strip() != "-"]
    return all(status.get(d) == "done" for d in deps)


# ---------------------------------------------------------------- maven

def maven(tests, label, modules="javaw-agent-kit", include_pending=True, forks=None):
    STATE.mkdir(parents=True, exist_ok=True)
    log = STATE / ("mvn-%s.log" % label)
    command = ["mvn", "-o", "-pl", modules, "-am", "-Dtest=" + ",".join(tests),
               "-Dsurefire.failIfNoSpecifiedTests=false", "-DtrimStackTrace=true"]
    if include_pending:
        command.append("-Dkit.excludedGroups=none")
    if forks:
        command.append("-Djavaw.test.forks=" + forks)
    command.append("test")
    print("running: " + " ".join(command))
    print("(full log: %s)" % log.relative_to(ROOT))
    with open(log, "w") as out:
        code = subprocess.run(command, cwd=ROOT, env=java_env(), stdout=out, stderr=subprocess.STDOUT).returncode
    return code, log


def summarize(log, limit=60):
    """Prints the useful part of a Maven run: test counts and the first lines of each failure, no stack frames."""
    text = Path(log).read_text(errors="replace")
    reports = sorted((ROOT).glob("*/target/surefire-reports/*.txt"), key=lambda p: p.stat().st_mtime, reverse=True)
    printed = 0
    for line in text.splitlines():
        if re.search(r"Tests run:.*(Fail|Err)", line) and "<<<" in line:
            print(line.strip())
    for report in reports:
        if report.stat().st_mtime + 600 < Path(log).stat().st_mtime:
            continue
        body = report.read_text(errors="replace")
        if "FAILURE!" not in body and "ERROR!" not in body:
            continue
        print("---- " + report.name)
        for line in body.splitlines():
            if re.match(r"\s+at ", line) or line.startswith("\tat ") or not line.strip() or "{let value;try{" in line \
                    or re.fullmatch(r"\s*\^+\s*", line) or line.startswith(("node:internal", "Node.js v")):
                continue
            print(line[:400])
            printed += 1
            if printed >= limit:
                print("... (truncated; see the report file above)")
                return
    if printed == 0:
        # Not a test failure: a compile error or a Maven problem. Show the [ERROR] lines.
        errors = [l for l in text.splitlines() if l.startswith("[ERROR]") and "Help 1" not in l and l.strip() != "[ERROR]"]
        for line in errors[:limit]:
            print(line[:400])


def run_tests(tests, label, **kwargs):
    code, log = maven(tests, label, **kwargs)
    if code == 0:
        print("PASS: " + ", ".join(tests))
        return True
    print("FAIL: " + ", ".join(tests))
    summarize(log)
    return False


# ---------------------------------------------------------------- guard rails

def start_commit(task_id):
    marker = STATE / task_id / "start"
    if not marker.exists():
        fail("task %s was not started; run `kit start %s` first" % (task_id, task_id))
    return marker.read_text().strip()


class WorkingTree:
    """Changes in the working tree (tracked and new untracked files) since the task's starting commit."""

    def __init__(self, base):
        self.base = base

    def files(self):
        files = set(git("diff", "--name-only", self.base).splitlines())
        untracked = set(git("ls-files", "--others", "--exclude-standard").splitlines())
        baseline = STATE / "untracked-before"
        before = set(baseline.read_text().splitlines()) if baseline.exists() else set()
        files |= untracked - before
        return sorted(f for f in files if not any(fnmatch.fnmatch(f, pattern) for pattern in IGNORED))

    def content(self, path):
        return (ROOT / path).read_text(errors="replace") if (ROOT / path).exists() else None

    def changed_lines(self, path):
        if path in git("ls-files", "--others", "--exclude-standard").splitlines():
            text = self.content(path)
            return ["+" + line for line in text.splitlines()] if text is not None else []
        diff = git("diff", "-U0", self.base, "--", path)
        return [l for l in diff.splitlines() if l[:1] in "+-" and not l.startswith(("+++", "---"))]


class Commit(WorkingTree):
    """Changes made by one commit, compared with its first parent."""

    def __init__(self, commit):
        self.commit = git("rev-parse", "--verify", commit + "^{commit}").strip()
        super().__init__(git("rev-parse", self.commit + "^").strip())

    def files(self):
        files = git("diff", "--name-only", self.base, self.commit).splitlines()
        return sorted(f for f in files if not any(fnmatch.fnmatch(f, pattern) for pattern in IGNORED))

    def content(self, path):
        result = subprocess.run(["git", "show", "%s:%s" % (self.commit, path)], cwd=ROOT, capture_output=True, text=True)
        return result.stdout if result.returncode == 0 else None

    def changed_lines(self, path):
        diff = git("diff", "-U0", self.base, self.commit, "--", path)
        return [l for l in diff.splitlines() if l[:1] in "+-" and not l.startswith(("+++", "---"))]


def added_lines(view, path):
    return [l[1:] for l in view.changed_lines(path) if l.startswith("+")]


def strip_comments(line, in_comment):
    """Removes string/char literals and // and /* */ comments; returns the code and whether a block comment is open."""
    code, index = [], 0
    while index < len(line):
        if in_comment:
            end = line.find("*/", index)
            if end < 0:
                return "".join(code), True
            index, in_comment = end + 2, False
            continue
        match = re.compile(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|//|/\*').search(line, index)
        if not match:
            code.append(line[index:])
            break
        code.append(line[index:match.start()])
        if match.group() == "//":
            break
        if match.group() == "/*":
            in_comment = True
        index = match.end()
    if not in_comment and re.match(r"\s*\*", line) and not code:
        return "", False
    return "".join(code), in_comment


TEST_DIR = "javaw-agent-kit/src/test/java/one/dastec/javaw/bytecode/"
UNTAG_LINE = re.compile(r'^[-+]\s*(@Tag\("agent-pending"\)|import org\.junit\.jupiter\.api\.Tag;)?\s*$')


def check(task_id, meta, view, review=False):
    """Returns the guard-rail problems of the changes in `view` for the task described by `meta`."""
    problems = []
    files = view.files()
    allowed = meta["allow"] + ALWAYS_ALLOWED
    tests = [TEST_DIR + test + ".java" for test in meta["tests"]]
    for path in files:
        if review and path in tests:
            # kit finish removes the agent-pending tag (and the then-unused import); nothing else may change.
            for line in view.changed_lines(path):
                if not UNTAG_LINE.match(line):
                    problems.append("%s: the task test was edited, not just untagged: %s" % (path, line.strip()[:120]))
            continue
        if not any(fnmatch.fnmatch(path, pattern) for pattern in allowed):
            problems.append("%s is outside this task's allowed files. Undo that change (allowed: %s)"
                            % (path, ", ".join(meta["allow"])))
        if path.endswith((".wat", ".wasm", ".class", ".map")):
            problems.append("%s is generated output; generated files belong in target/ only" % path)
    registry = view.content(REGISTRY) or ""
    for path in files:
        text = view.content(path)
        if not (path.startswith(RUNTIME) and path.endswith(".java") and text is not None):
            continue
        in_comment = False
        for line in added_lines(view, path):
            code, in_comment = strip_comments(line, in_comment)
            for pattern, why in FORBIDDEN_IN_RUNTIME:
                if re.search(pattern, code):
                    problems.append("%s: added line uses a forbidden construct (%s): %s" % (path, why, line.strip()[:120]))
        name, relative = Path(path).stem, path[len(RUNTIME):]
        top_level = re.search(r"^\s*(public\s+)?(abstract\s+|final\s+|sealed\s+)*(class|interface|enum|record|@interface)\s+"
                              + re.escape(name) + r"\b", text, re.M)
        if top_level and not re.search(r"\b" + re.escape(name) + r"\b", registry) and relative not in registry:
            problems.append("%s is not registered in %s; unregistered runtime sources are silently ignored" % (path, REGISTRY))
    if REGISTRY in files:
        for line in view.changed_lines(REGISTRY):
            body = line[1:]
            if not re.search(r"paths\.add\(|List\.of\(|NAMES|^\s*\+\s*\"|\.split\(", body):
                problems.append("%s: only registration lines may change, not: %s" % (REGISTRY, body.strip()[:120]))
    for path, pattern in ((CACHE_METADATA, r"COMPILER_VERSION"), (BASELINE, r"compilerRevision")):
        if path in files:
            for line in view.changed_lines(path):
                if not re.search(pattern, line):
                    problems.append("%s: only the revision line may change (bin/kit finish does it): %s" % (path, line[1:].strip()[:120]))
    for test in tests:
        if view.content(test) is None:
            problems.append("task test %s is missing" % test)
    if review:
        problems += check_revision(meta, view)
        problems += check_queue(task_id, view, "done")
        if (view.content(TEST_DIR + meta["tests"][0] + ".java") or "").find('@Tag("agent-pending")') >= 0:
            problems.append("the task test is still tagged agent-pending, so it does not run as a regression test")
    return problems


def revision_of(text, pattern):
    match = re.search(pattern, text or "")
    return match.group(1) if match else None


def check_revision(meta, view):
    """A finished task bumps both revision files to <slug>-v<parent + 1>."""
    metadata_pattern, baseline_pattern = r'COMPILER_VERSION = "([^"]+)"', r'"compilerRevision": "([^"]+)"'
    before = subprocess.run(["git", "show", "%s:%s" % (view.base, CACHE_METADATA)], cwd=ROOT, capture_output=True, text=True).stdout
    old = revision_of(before, metadata_pattern)
    new = revision_of(view.content(CACHE_METADATA), metadata_pattern)
    in_baseline = revision_of(view.content(BASELINE), baseline_pattern)
    problems = []
    old_number = int(old.rsplit("-v", 1)[1]) if old and "-v" in old else None
    expected = "1.0-SNAPSHOT-%s-v%d" % (meta["slug"], old_number + 1) if old_number is not None else None
    if new != expected:
        problems.append("compiler revision is %s; expected %s (one step up from %s)" % (new, expected, old))
    if in_baseline != new:
        problems.append("audit-baseline.json compilerRevision %s does not match CacheMetadata %s" % (in_baseline, new))
    return problems


def check_queue(task_id, view, status):
    """QUEUE.md may change only in the task's own status cell."""
    problems = []
    for line in view.changed_lines("javaw-agent-kit/tasks/QUEUE.md"):
        cells = [c.strip() for c in line[1:].strip().strip("|").split("|")]
        if not cells or cells[0] != task_id:
            problems.append("QUEUE.md: a row other than %s changed: %s" % (task_id, line[1:].strip()[:120]))
        elif line.startswith("+") and cells[-1] != status:
            problems.append("QUEUE.md: %s is marked %s, expected %s" % (task_id, cells[-1], status))
    return problems


def report(task_id, problems, files, label="GUARD"):
    if problems:
        print("%s FAILED for %s:" % (label, task_id))
        for problem in problems:
            print("  - " + problem)
        return False
    print("%s OK for %s (%d changed files: %s)" % (label, task_id, len(files), ", ".join(files) or "none"))
    return True


def guard(task_id, quiet=False):
    meta = task_meta(task_id)
    view = WorkingTree(start_commit(task_id))
    problems = check(task_id, meta, view)
    return report(task_id, problems, view.files()) if (problems or not quiet) else True


def trusted_task_meta(task_id, ref):
    """Task metadata as committed on `ref`, so a reviewed branch cannot widen its own allow-list."""
    names = git("ls-tree", "--name-only", ref, "javaw-agent-kit/tasks/").splitlines()
    matches = [n for n in names if re.fullmatch(r"javaw-agent-kit/tasks/%s-.*\.md" % re.escape(task_id), n)]
    if len(matches) != 1:
        fail("%s has no single task file for %s" % (ref, task_id))
    return parse_meta(git("show", "%s:%s" % (ref, matches[0])))


# ---------------------------------------------------------------- commands

def cmd_doctor(_):
    ok = True
    env = java_env()
    try:
        version = subprocess.run(["java", "-version"], env=env, capture_output=True, text=True).stderr
    except FileNotFoundError:
        version = ""
    if '"21.' not in version:
        print("JDK 21 not found at %s (set KIT_JAVA_HOME). The bytecode suite fails on JDK 24+." % env["JAVA_HOME"])
        ok = False
    for tool in ("mvn", "wat2wasm", "node", "git"):
        if not shutil.which(tool, path=env["PATH"]):
            print("missing tool: " + tool)
            ok = False
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip()
    print("branch: %s (tasks are committed on %s)" % (branch, WORK_BRANCH))
    print("doctor: " + ("OK" if ok else "PROBLEMS FOUND"))
    return ok


def cmd_status(_):
    rows = queue_rows()
    for row in rows:
        ready = row["status"] == "todo" and deps_done(row, rows)
        print("%-4s %-8s %s%s" % (row["id"], row["status"], row["title"], "   <- ready" if ready else ""))
    return True


def cmd_next(args):
    rows = queue_rows()
    for row in rows:
        if row["status"] in ("todo", "in-progress") and deps_done(row, rows):
            if args and args[0] == "--id":
                print(row["id"])
            else:
                print("NEXT TASK: %s  %s" % (row["id"], row["title"]))
                print("spec:      %s" % task_file(row["id"]).relative_to(ROOT))
                print("then run:  javaw-agent-kit/bin/kit start %s" % row["id"])
            return True
    print("No task is ready. Every remaining task is done, blocked, or waiting on a blocked dependency.")
    return False


def cmd_start(args):
    if not args:
        fail("usage: kit start T01")
    task_id = args[0]
    meta = task_meta(task_id)
    rows = {r["id"]: r for r in queue_rows()}
    if task_id not in rows:
        fail("%s is not in tasks/QUEUE.md" % task_id)
    if rows[task_id]["status"] == "done":
        fail("%s is already done" % task_id)
    queue_deps = [d.strip() for d in rows[task_id]["depends"].split(",") if d.strip() and d.strip() != "-"]
    missing = [d for d in sorted(set(meta["depends"]) | set(queue_deps)) if rows.get(d, {}).get("status") != "done"]
    if missing:
        fail("%s depends on unfinished tasks: %s" % (task_id, ", ".join(missing)))
    if not cmd_doctor([]):
        fail("fix the environment first")
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip()
    if branch != WORK_BRANCH:
        dirty = [f for f in git("status", "--porcelain").splitlines() if not any(fnmatch.fnmatch(f[3:], p) for p in IGNORED)]
        tracked_dirty = [f for f in dirty if not f.startswith("??")]
        if tracked_dirty:
            fail("uncommitted tracked changes; commit or stash them before switching to %s:\n%s" % (WORK_BRANCH, "\n".join(tracked_dirty)))
        exists = git("rev-parse", "--verify", "--quiet", WORK_BRANCH, check=False).strip()
        git("switch", WORK_BRANCH) if exists else git("switch", "-c", WORK_BRANCH)
    (STATE / task_id).mkdir(parents=True, exist_ok=True)
    marker = STATE / task_id / "start"
    if not marker.exists():
        marker.write_text(git("rev-parse", "HEAD").strip())
    baseline = STATE / "untracked-before"
    if not baseline.exists() or rows[task_id]["status"] != "in-progress":
        baseline.write_text(git("ls-files", "--others", "--exclude-standard"))
    set_status(task_id, "in-progress")
    print("STARTED %s on branch %s from %s" % (task_id, WORK_BRANCH, marker.read_text()[:10]))
    print("Read the spec: %s" % task_file(task_id).relative_to(ROOT))
    print("Tests to make pass: %s" % ", ".join(meta["tests"]))
    print("Files you may change: %s (+ registration in BytecodeExceptionRuntime.java, + reports/%s.md)"
          % (", ".join(meta["allow"]), task_id))
    return True


def cmd_check(args):
    if not args:
        fail("usage: kit check T01")
    meta = task_meta(args[0])
    return run_tests(meta["tests"], "check-" + args[0])


def cmd_regress(_):
    return run_tests(REGRESSION, "regress")


def cmd_guard(args):
    if not args:
        fail("usage: kit guard T01")
    return guard(args[0])


def bump_revision(task_id, slug):
    """Sets the revision to <slug>-v<N+1>, where N is the revision at the task's starting commit (safe to rerun)."""
    base = start_commit(task_id)
    started = re.search(r'COMPILER_VERSION = "1\.0-SNAPSHOT-[a-z0-9-]+-v(\d+)"', git("show", "%s:%s" % (base, CACHE_METADATA)))
    metadata = ROOT / CACHE_METADATA
    text = metadata.read_text()
    current = re.search(r'COMPILER_VERSION = "([^"]+)"', text)
    if not started or not current:
        fail("cannot find COMPILER_VERSION in " + CACHE_METADATA)
    new = "1.0-SNAPSHOT-%s-v%d" % (slug, int(started.group(1)) + 1)
    metadata.write_text(text.replace(current.group(0), 'COMPILER_VERSION = "%s"' % new))
    baseline = ROOT / BASELINE
    baseline_text = baseline.read_text()
    revision = re.search(r'"compilerRevision": "([^"]+)"', baseline_text)
    if not revision:
        fail("cannot find compilerRevision in " + BASELINE)
    baseline.write_text(baseline_text.replace(revision.group(0), '"compilerRevision": "%s"' % new))
    print("revision: %s -> %s" % (current.group(1), new))
    return new


def cmd_finish(args):
    if not args:
        fail("usage: kit finish T01")
    task_id = args[0]
    meta = task_meta(task_id)
    report = REPORTS / (task_id + ".md")
    print("== 1/7 guard rails")
    if not guard(task_id):
        fail("fix the guard problems above, then run finish again")
    print("== 2/7 report")
    if not report.exists() or len(report.read_text().strip()) < 80:
        fail("write %s first (see AGENT.md: what you implemented, what you left out, anything surprising)" % report.relative_to(ROOT))
    print("== 3/7 task tests")
    if not run_tests(meta["tests"], "finish-" + task_id):
        fail("task tests fail")
    print("== 4/7 compiler revision")
    revision = bump_revision(task_id, meta["slug"])
    print("== 5/7 full bytecode suite + kit tests (about 1-2 minutes)")
    if not run_tests(["one.dastec.javaw.bytecode.*Test"], "full", modules="javaw-bytecode,javaw-agent-kit",
                     include_pending=False, forks=os.environ.get("KIT_FORKS")):
        fail("the full suite fails; a runtime change broke something else. Fix it, or `kit block` if it is not yours")
    print("== 6/7 dependency audit baseline")
    audit = subprocess.run(["python3", "runtime-target/audit.py", "--check-baseline"], cwd=ROOT, env=java_env(),
                           capture_output=True, text=True)
    if audit.returncode != 0:
        print((audit.stdout + audit.stderr)[-3000:])
        fail("audit baseline check failed. Do NOT refresh the baseline; report it with `kit block`")
    print("== 7/7 commit")
    for test in meta["tests"]:
        source = KIT / "src" / "test" / "java" / "one" / "dastec" / "javaw" / "bytecode" / (test + ".java")
        text = re.sub(r'^[ \t]*@Tag\("agent-pending"\)[ \t]*\n', "", source.read_text(), flags=re.M)
        if "@Tag(" not in text:
            text = re.sub(r'^import org\.junit\.jupiter\.api\.Tag;\n', "", text, flags=re.M)
        source.write_text(text)
    set_status(task_id, "done")
    base = start_commit(task_id)
    files = WorkingTree(base).files()
    files += [str(s.relative_to(ROOT)) for s in (KIT / "src/test/java/one/dastec/javaw/bytecode").glob("*.java")
              if git("diff", "--name-only", "--", str(s.relative_to(ROOT))).strip()]
    git("add", "--", *sorted(set(files)))
    model = os.environ.get("KIT_MODEL", "local model")
    message = "feat(bytecode): %s (agent kit %s, %s)\n\n%s\n\nAssisted-by: %s via javaw-agent-kit\n" % (
        meta["title"], task_id, revision.rsplit("-", 1)[-1], report.read_text().strip()[:1500], model)
    git("commit", "-m", message)
    print("DONE %s: committed %s on %s. Next: `kit next`." % (task_id, git("rev-parse", "--short", "HEAD").strip(), WORK_BRANCH))
    return True


def cmd_block(args):
    if len(args) < 2:
        fail('usage: kit block T01 "reason"')
    task_id, reason = args[0], " ".join(args[1:])
    meta = task_meta(task_id)
    base = start_commit(task_id)
    files = WorkingTree(base).files()
    patch = STATE / task_id / "attempt.patch"
    untracked = set(git("ls-files", "--others", "--exclude-standard").splitlines())
    for path in files:
        if path in untracked:
            git("add", "-N", "--", path)
    work = [f for f in files if not (f.startswith("javaw-agent-kit/reports/") or f == "javaw-agent-kit/tasks/QUEUE.md")]
    patch.write_text(git("diff", base, "--", *work) if work else "")
    for path in files:
        if path in untracked:
            git("rm", "--cached", "-q", "--", path)
            (ROOT / path).unlink(missing_ok=True)
        elif path.startswith("javaw-agent-kit/reports/") or path == "javaw-agent-kit/tasks/QUEUE.md":
            continue
        else:
            git("checkout", base, "--", path)
    REPORTS.mkdir(exist_ok=True)
    report = REPORTS / (task_id + ".md")
    previous = report.read_text() if report.exists() else ""
    report.write_text("# %s BLOCKED\n\nReason: %s\n\nAttempt saved to %s (not committed).\n\n%s"
                      % (task_id, reason, patch.relative_to(ROOT), previous))
    set_status(task_id, "blocked")
    git("add", "--", str(report.relative_to(ROOT)), str(QUEUE.relative_to(ROOT)))
    git("commit", "-m", "chore(agent-kit): block %s (%s)\n\n%s\n" % (task_id, meta["title"], reason))
    print("BLOCKED %s. Attempt saved to %s. Move on with `kit next`." % (task_id, patch.relative_to(ROOT)))
    return True


def cmd_review(args):
    """Checks agent commits (default: every commit on the work branch that is not on the trusted ref)."""
    ref = "main"
    if "--trusted-ref" in args:
        index = args.index("--trusted-ref")
        ref = args[index + 1]
        args = args[:index] + args[index + 2:]
    git("rev-parse", "--verify", ref)
    commits = args or list(reversed(git("rev-list", "%s..%s" % (ref, WORK_BRANCH)).split()))
    if not commits:
        print("Nothing to review: %s has no commits that are not on %s." % (WORK_BRANCH, ref))
        return True
    ok = True
    for commit in commits:
        view = Commit(commit)
        subject = git("log", "-1", "--format=%s", view.commit).strip()
        short = view.commit[:10]
        task = re.search(r"agent kit (T\d+)|block (T\d+)", subject)
        if not task:
            print("REVIEW SKIPPED %s: not a kit commit (%s)" % (short, subject))
            continue
        task_id = task.group(1) or task.group(2)
        print("== %s %s" % (short, subject))
        if task.group(2):
            files = view.files()
            problems = ["%s: a block commit may change only the report and QUEUE.md" % f for f in files
                        if f not in ("javaw-agent-kit/tasks/QUEUE.md", "javaw-agent-kit/reports/%s.md" % task_id)]
            problems += check_queue(task_id, view, "blocked")
        else:
            problems = check(task_id, trusted_task_meta(task_id, ref), view, review=True)
        ok = report(task_id, problems, view.files(), label="REVIEW") and ok
    if ok:
        print("Guard rails hold. Now read the runtime code itself (REVIEW.md step 2).")
    return ok


COMMANDS = {"doctor": cmd_doctor, "status": cmd_status, "next": cmd_next, "start": cmd_start, "check": cmd_check,
            "regress": cmd_regress, "guard": cmd_guard, "review": cmd_review, "finish": cmd_finish, "block": cmd_block}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        sys.exit(1)
    sys.exit(0 if COMMANDS[sys.argv[1]](sys.argv[2:]) else 1)
