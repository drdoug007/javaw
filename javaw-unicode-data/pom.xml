<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>one.dastec</groupId>
        <artifactId>javaw</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!--
      Java 17 / Unicode 13 tables for the bytecode compiler's bundled runtime, generated from a JDK 17 installation by
      the Java programs in tools/ (no Python). The jar holds the runtime sources under exception-runtime/ and the
      javaw-unicode-data/character-traversal-jdk17.txt test oracle, which javaw-bytecode's tests read. It is in the main
      jar, not a test jar, so -Dmaven.test.skip=true cannot drop it. See docs/bytecode-unicode-case.md#reproducible-data.
    -->
    <artifactId>javaw-unicode-data</artifactId>

    <properties>
        <!-- JDK 17 used to derive the tables; empty means discover it (JAVA_HOME_17*, macOS java_home). -->
        <javaw.jdk17.home></javaw.jdk17.home>
        <javaw.generated.resources>${project.build.directory}/generated-resources/jdk17</javaw.generated.resources>
    </properties>

    <build>
        <!-- The generated tables are resources, like the hand-written runtime sources, but live only in target/. -->
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>${javaw.generated.resources}</directory></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-jdk17-data</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <!-- Maven's own JDK runs the orchestrator in single-file source mode; it starts JDK 17 for each table. -->
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/tools/GenerateJdk17Data.java</argument>
                                <argument>--tools=${project.basedir}/tools</argument>
                                <argument>--java-home=${javaw.jdk17.home}</argument>
                                <argument>--resources=${javaw.generated.resources}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
