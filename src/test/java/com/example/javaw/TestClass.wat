(module
  (memory (export "memory") 1)
  ;; Class/Interface: TestClass
  (func $sayHello (export "sayHello")
  )
  (func $addNumbers (export "addNumbers") (param $a i32) (param $b i32) (result i32)
    local.get $a
    local.get $b
    i32.add
  )
  (func $getPi (export "getPi") (result f64)
    f64.const 3.14159
  )
  (func $calculateFactorial (export "calculateFactorial") (param $n i32) (result i32)
    (local $result i32)
    (local $i i32)
    i32.const 1
    local.set $result
    i32.const 1
    local.set $i
    (block $break_for_1
      (loop $loop_for_1
    local.get $i
    local.get $n
    i32.le_s
        i32.eqz
        br_if $break_for_1
        (block $continue_for_1
    local.get $result
    local.get $i
    i32.mul
    local.set $result
        )
    local.get $i
    i32.const 1
    i32.add
    local.set $i
        br $loop_for_1
      )
    )
    local.get $result
  )
  (func $sumRangeWithSkips (export "sumRangeWithSkips") (param $n i32) (result i32)
    (local $sum i32)
    (local $i i32)
    i32.const 0
    local.set $sum
    i32.const 1
    local.set $i
    (block $break_for_2
      (loop $loop_for_2
    local.get $i
    local.get $n
    i32.le_s
        i32.eqz
        br_if $break_for_2
        (block $continue_for_2
    local.get $i
    i32.const 3
    i32.eq
    (if
      (then
    br $continue_for_2
      )
    )
    local.get $i
    i32.const 8
    i32.gt_s
    (if
      (then
    br $break_for_2
      )
    )
    local.get $sum
    local.get $i
    i32.add
    local.set $sum
        )
    local.get $i
    i32.const 1
    i32.add
    local.set $i
        br $loop_for_2
      )
    )
    local.get $sum
  )
)
