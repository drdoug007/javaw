<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>one.dastec</groupId>
        <artifactId>javaw</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>javaw-components</artifactId>
    <name>javaw web components</name>
    <description>Custom elements authored as Java classes: the API (@CustomElement, WebComponent) and the javaw source compiler extension that lowers it. See docs/web-components.md.</description>
    <dependencies>
        <dependency>
            <groupId>one.dastec</groupId>
            <artifactId>javaw-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- @Language("HTML"/"CSS") on html(...)/css(...) for IDE language injection; CLASS retention, not needed at run time. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
